# KEYSTONE frontend - copy to `.env.local` (never commit real values).
# Only variables prefixed VITE_ are exposed to the browser bundle.

# Dev only: where the Vite dev server proxies "/api" to.
VITE_PROXY_TARGET=http://localhost:8080

# Production / preview: absolute backend URL, e.g. https://api.example.com
# Leave empty in dev so requests go through the proxy above.
VITE_API_BASE_URL=
