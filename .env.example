# KEYSTONE backend - environment variable template
# Copy this file to `.env` for local reference and fill in real values there.
# Spring Boot does not read .env files automatically - export these as real
# environment variables (or pass -D system properties) before running the app,
# e.g.:
#   export $(grep -v '^#' .env | xargs)   # Linux/macOS shells
# or set them in your IDE run configuration / systemd unit / container env.

# ---- Server ----
SERVER_PORT=8080

# ---- PostgreSQL ----
DB_URL=jdbc:postgresql://localhost:5432/authapp_db
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ---- JPA / Hibernate ----
# "validate" only checks entities against the existing schema at startup.
# Never set this to "update" or "create" against a real database - Flyway
# migrations (src/main/resources/db/migration) own the production schema.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ---- Flyway ----
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false

# ---- JWT (existing auth feature - unchanged in this phase) ----
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=86400000

# ---- SLA (Step 7) - all optional, defaults shown ----
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=24
SLA_MEDIUM_HOURS=48
SLA_LOW_HOURS=72
SLA_AT_RISK_PERCENT=25
SLA_SCHEDULER_ENABLED=true
SLA_CHECK_INTERVAL_MS=60000
SLA_CHECK_INITIAL_DELAY_MS=30000

# ---- Docker Compose (docker-compose.yml) - all optional, defaults shown ----
# Compose reads this file (copied to .env) automatically. DB_USERNAME / DB_PASSWORD /
# JWT_SECRET above are reused by the containers.
POSTGRES_DB=authapp_db
DB_HOST_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=3000
